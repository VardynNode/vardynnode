[Unit]
Description=Weekly refresh of Cloudflare IP ranges for nginx real_ip module

[Timer]
# Run weekly on Sunday at 03:00 UTC (CF adds ranges before production use)
OnCalendar=Sun 03:00:00 UTC
# Also run 5 minutes after boot (catches range changes after a gap)
OnBootSec=5min
Persistent=true

[Install]
WantedBy=timers.target
